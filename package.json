{
    "name": "@arijitgupta/geo-core",
    "version": "1.0.0",
    "description": "Shared geographic types, validation, coordinate conversion, normalization, and angular utilities.",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/ArijitGupta-in/geo-core.git"
    },
    "homepage": "https://github.com/ArijitGupta-in/geo-core",
    "bugs": {
        "url": "https://github.com/ArijitGupta-in/geo-core/issues"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": false,
    "scripts": {
        "build": "tsc",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
        "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
        "prepublishOnly": "npm run check && npm run test:coverage && npm run build"
    },
    "keywords": [
        "geo",
        "geospatial",
        "coordinates",
        "latitude",
        "longitude",
        "dms",
        "geography",
        "validation",
        "normalization"
    ],
    "author": "Arijit Gupta",
    "license": "MIT",
    "devDependencies": {
        "@vitest/coverage-v8": "^4.1.11",
        "markdownlint-cli2": "^0.23.2",
        "typescript": "^7.0.2",
        "vitest": "^4.1.11"
    }
}
